# ==============================================================================
# AI PROSPECTING AGENT - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in your actual values
# For production deployment with Encore Cloud, use secrets management instead
# ==============================================================================

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (Required)
# ------------------------------------------------------------------------------
# PostgreSQL database for storing prospects, campaigns, analytics
# Default values work with Docker Compose setup
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_crm
POSTGRES_DB=ai_crm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# ------------------------------------------------------------------------------
# REDIS CONFIGURATION (Required)
# ------------------------------------------------------------------------------
# Used for caching and real-time features
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# ENVIRONMENT SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# ------------------------------------------------------------------------------
# CLERK AUTHENTICATION (Required for Frontend)
# ------------------------------------------------------------------------------
# Get your keys from: https://dashboard.clerk.com/
# 1. Create a free account at clerk.com
# 2. Create a new application
# 3. Copy the publishable and secret keys from the API Keys section
#
# NOTE: A test key is hardcoded in frontend/App.tsx for quick testing
# For production, you MUST replace it with your own keys
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# ------------------------------------------------------------------------------
# OPENAI API (CRITICAL - Required for AI Features)
# ------------------------------------------------------------------------------
# Get your API key from: https://platform.openai.com/api-keys
# Cost: ~$0.001-0.01 per AI generation (very affordable)
#
# Without this key, the following features will NOT work:
# - AI-powered lead scoring
# - Personalized email content generation
# - Intelligent prospect classification
# - Smart nurturing sequence recommendations
# - HubSpot automation decisions
#
# The system has fallbacks, but AI features are core to prospecting
OpenAIKey=your_openai_api_key_starting_with_sk

# ------------------------------------------------------------------------------
# EMAIL CONFIGURATION (Required for Sending Emails)
# ------------------------------------------------------------------------------
# Gmail setup (recommended for getting started):
# 1. Enable 2-factor authentication on your Gmail account
# 2. Generate an app password: https://myaccount.google.com/apppasswords
# 3. Use your email as SMTP_USER and the app password as SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# ------------------------------------------------------------------------------
# HUBSPOT INTEGRATION (Optional)
# ------------------------------------------------------------------------------
# Only needed if you want to sync with HubSpot CRM
# Get your API key from: https://app.hubspot.com/settings/integrations/api
HUBSPOT_API_KEY=your_hubspot_private_app_token

# ------------------------------------------------------------------------------
# STRIPE PAYMENT PROCESSING (Optional)
# ------------------------------------------------------------------------------
# Only needed if you're offering this as a SaaS product with billing
# Get your keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ------------------------------------------------------------------------------
# APPLICATION URLs
# ------------------------------------------------------------------------------
# Frontend runs on 5173 (Vite default), backend on 4000 (Encore default)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000

# ------------------------------------------------------------------------------
# SECURITY & RATE LIMITING
# ------------------------------------------------------------------------------
# JWT secret for token signing (generate a random string)
JWT_SECRET=your_random_jwt_secret_at_least_32_characters_long

# Rate limiting configuration
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# ------------------------------------------------------------------------------
# MONITORING & LOGGING (Optional)
# ------------------------------------------------------------------------------
# Sentry for error tracking (optional but recommended for production)
SENTRY_DSN=your_sentry_dsn
LOG_LEVEL=info

# ==============================================================================
# MINIMUM VIABLE SETUP (to get started quickly)
# ==============================================================================
# 1. REQUIRED (App won't run without these):
#    - OpenAIKey (for AI features - get from platform.openai.com)
#    - SMTP credentials (for sending emails)
#    - Clerk keys OR use the test key in App.tsx for now
#
# 2. OPTIONAL (for advanced features):
#    - HUBSPOT_API_KEY (only if using HubSpot integration)
#    - STRIPE keys (only if monetizing as SaaS)
#    - SENTRY_DSN (only for production monitoring)
#
# 3. AUTO-CONFIGURED (via Docker Compose):
#    - DATABASE_URL (PostgreSQL)
#    - REDIS_URL
# ==============================================================================